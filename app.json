{
  "expo": {
    "name": "Eduverse",
    "slug": "eduverse-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduverse.lms",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F5EFE"
      },
      "package": "com.eduverse.lms",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5EFE"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F5EFE"
        }
      ],
      "expo-background-task"
    ]
  }
}
