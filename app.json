{
  "expo": {
    "name": "TCF Campus",
    "slug": "eduverse-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduverse.lms",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.eduverse.lms",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/tcf-mark.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A7F3F",
          "icon": "./assets/tcf-mark-white.png"
        }
      ],
      "expo-background-task",
      "expo-font"
    ],
    "icon": "./assets/icon.png"
  }
}
